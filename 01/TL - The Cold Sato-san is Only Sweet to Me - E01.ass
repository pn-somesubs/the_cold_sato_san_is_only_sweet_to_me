Dialogue: 0,0:00:00.00,0:00:11.00,Default,SOTA,0,0,0,,{\fs17\an7\fe162\b\fad(400,400)\bord2\blur5\shad\4c&H000000&\4a&HFF&\fnSweetest Cat Ever\pos(6,-5.67)}\N{\pos(20,1)}{\c&HFFFF00&}{\4c&H8485E4&}SomeSub ekip arkadaşı arıyor!\N{\pos(60,63)}{\c&HFFFFFF&}Çevirmen:{\c&HFFFF00&} Umav\N{\pos(60,111)}{\c&HFFFFFF&}Encode:{\c&HFFFF00&} Velnoxy\N{\pos(60,111)}{\c&HFFFFFF&}Redaktör:{\c&HFFFF00&} Umav\N{\c&HFFFFFF&}Discord:{\c&HFFFF00&} discord.gg/somesub
Dialogue: 0,0:00:15.69,0:00:17.20,Default,SOTA,0,0,0,,Beklediğiniz için çok teşekkürler.
Dialogue: 0,0:00:18.37,0:00:20.84,Default,SOTA,0,0,0,,İşte ballı pankekiniz.
Dialogue: 0,0:00:20.84,0:00:22.29,Default,FEMALE CUSTOMER 1,0,0,0,,Lezzetli görünüyor!
Dialogue: 0,0:00:22.29,0:00:24.31,Default,SOTA,0,0,0,,Siparişiniz tam mı?
Dialogue: 0,0:00:24.31,0:00:25.05,Default,FEMALE CUSTOMER 2,0,0,0,,Evet.
Dialogue: 0,0:00:25.05,0:00:27.91,Default,SOTA,0,0,0,,Harika. Lütfen acele etmeyin \Nve afiyetle yiyin!
Dialogue: 0,0:00:27.91,0:00:30.39,Default,FEMALE CUSTOMER 1 & 2,0,0,0,,Kesinlikle tadını çıkaracağız!
Dialogue: 0,0:00:30.61,0:00:32.42,Default,FEMALE CUSTOMER 1,0,0,0,,Burası çok hoş bir yer değil mi?
Dialogue: 0,0:00:32.42,0:00:33.89,Default,FEMALE CUSTOMER 2,0,0,0,,Gerçekten öyle!
Dialogue: 0,0:00:33.89,0:00:37.76,Italics,SOTA,0,0,0,,Benim, Oshio Sota'nun çalıştığı Café Tutuji.
Dialogue: 0,0:00:37.76,0:00:40.62,Italics,SOTA,0,0,0,,Mahalle arasına gizlenmiş \Nbir bahçe kafesidir.
Dialogue: 0,0:00:41.03,0:00:44.15,Italics,SOTA,0,0,0,,Müşterilerimizin çoğu \Nkadınlar ve çiftlerdir.
Dialogue: 0,0:00:44.15,0:00:46.78,Italics,SOTA,0,0,0,,Bu yüzden tek başına gelenler oldukça nadirdir.
Dialogue: 0,0:00:50.68,0:00:52.53,Default,KOHARU,0,0,0,,Geniş açı... olur mu ki?
Dialogue: 0,0:00:52.88,0:00:56.90,Italics,SOTA,0,0,0,,Muhtemelen bu yüzden \Nonu hemen fark ettim.
Dialogue: 0,0:00:57.17,0:01:02.41,Default,KOHARU,0,0,0,,Geniş açı olarak \Ndaha mı iyi olur? Hayır, yakın çekim mi?
Dialogue: 0,0:01:02.70,0:01:03.93,Default,SOTA,0,0,0,,Bu...!
Dialogue: 0,0:01:04.41,0:01:07.27,Default,KOHARU,0,0,0,,İştah açıcı görünmesini istiyorum...
Dialogue: 0,0:01:07.27,0:01:08.92,Default,KOHARU,0,0,0,,Belki... şöyle?
Dialogue: 0,0:01:14.03,0:01:15.30,Italics,SOTA,0,0,0,,Sato Koharu.
Dialogue: 0,0:01:15.83,0:01:18.80,Italics,SOTA,0,0,0,,O da benim gibi Sakuraba \NLisesi'nde ikinci sınıf öğrencisi.
Dialogue: 0,0:01:19.44,0:01:20.80,Flashback,FEMALE STUDENT 1,0,0,0,,O Sato-san mı?
Dialogue: 0,0:01:18.81,0:01:22.01,Flashback Top,MALE STUDENT 1,0,0,0,,Şu dedikodulardaki Sato-san mı?
Dialogue: 0,0:01:21.12,0:01:25.98,Italics,SOTA,0,0,0,,Bir yıl önce okula başladığımızdan \Nberi biraz ünlü biriydi.
Dialogue: 0,0:01:27.06,0:01:29.64,Italics,SOTA,0,0,0,,Çarpıcı görünümü ve havalı, \Nsakin tavrıyla.
Dialogue: 0,0:01:29.64,0:01:33.14,Italics,SOTA,0,0,0,,Kız erkek demeden sayısız \Nöğrencinin kalbini çalmıştı...
Dialogue: 0,0:01:33.14,0:01:34.08,Italics,SOTA,0,0,0,,Ve aynı zamanda...
Dialogue: 0,0:01:35.12,0:01:36.56,Flashback,MALE STUDENT 2,0,0,0,,Sato-san!
Dialogue: 0,0:01:37.27,0:01:40.84,Flashback,MALE STUDENT 2,0,0,0,,Gelecek cumartesi, bana \Nkatılıp birlikte...
Dialogue: 0,0:01:40.84,0:01:42.12,Flashback,KOHARU,0,0,0,,Neden?
Dialogue: 0,0:01:42.96,0:01:46.92,Flashback,KOHARU,0,0,0,,Üstelik seni zar zor tanıyorum.
Dialogue: 0,0:01:50.64,0:01:51.74,Flashback,MALE STUDENT 3,0,0,0,,Sato-san!
Dialogue: 0,0:01:51.74,0:01:53.84,Flashback,MALE STUDENT 3,0,0,0,,Okuldan sonra bovling oynamaya ne dersin?
Dialogue: 0,0:01:53.84,0:01:55.33,Flashback,KOHARU,0,0,0,,Hayır, teşekkürler.
Dialogue: 0,0:01:56.12,0:01:57.28,Flashback,FEMALE STUDENT 2,0,0,0,,Sato-san!
Dialogue: 0,0:01:57.28,0:02:00.46,Flashback,FEMALE STUDENT 2,0,0,0,,Ben amigo kız kulübündenim. \NKatılmak ister misin?
Dialogue: 0,0:02:00.46,0:02:01.88,Flashback,KOHARU,0,0,0,,İlgilenmiyorum.
Dialogue: 0,0:02:02.67,0:02:04.50,Flashback,MALE STUDENT 4,0,0,0,,Sato-san! Eve birlikte yürümek ister...
Dialogue: 0,0:02:04.50,0:02:06.32,Flashback,KOHARU,0,0,0,,Meşgulüm.
Dialogue: 0,0:02:07.57,0:02:11.46,Italics,SOTA,0,0,0,,Buz gibi soğuk muamelesi \Nonları tamamen yıkıma uğratıyordu.
Dialogue: 0,0:02:12.56,0:02:14.36,Italics,SOTA,0,0,0,,Bana gelince...
Dialogue: 0,0:02:14.36,0:02:16.92,Italics,SOTA,0,0,0,,Ben de bir keresinde ona selam vermeyi denedim ama...
Dialogue: 0,0:02:17.26,0:02:19.46,Flashback,SOTA,0,0,0,,Sen Sato-san'sın... değil mi?
Dialogue: 0,0:02:19.46,0:02:20.64,Flashback,SOTA,0,0,0,,S-Sen de...
Dialogue: 0,0:02:20.64,0:02:22.80,Flashback,KOHARU,0,0,0,,Sen kimsin?
Dialogue: 0,0:02:23.88,0:02:24.70,Flashback,SOTA,0,0,0,,Ha?
Dialogue: 0,0:02:37.99,0:02:40.68,Italics,SOTA,0,0,0,,{\t(2044,3546,\1c&HFFFFFF&\3c&HFFFFFF&\4c&HFFFFFF&)}Her etkileşim \Naşağı yukarı böyleydi.
Dialogue: 0,0:02:45.72,0:02:47.27,Italics,SOTA,0,0,0,,Bu ona şu lakabı kazandırdı...
Dialogue: 0,0:02:59.56,0:03:03.05,Italics,SOTA,0,0,0,,Soğuk Sato-san.
Dialogue: 0,0:03:13.42,0:03:15.46,Sign_Default,SIGN,0,0,0,,{\an8\fnTimes New Roman\shad0\fs22\c&HC4C826&\bord0\b1\fad(482,140)}{\c&H9657E9&}Soğuk Sato-san {\c&HC4C826&}Sadece Bana {\c&H9657E9&}Tatlı
